// INERTE — política de referência para o tailnet (colar no admin só após aprovação).
// Um tailnet novo permite tudo até se restringir: substituir a regra padrão por esta.
{
  "tagOwners": { "tag:qode-office": ["autogroup:admin"] },
  "acls": [
    // Só os dispositivos do Matheus, só a porta 443 do Office.
    { "action": "accept", "src": ["autogroup:member"], "dst": ["tag:qode-office:443"] }
  ],
  "nodeAttrs": [],
  "tests": [
    { "src": "autogroup:member", "accept": ["tag:qode-office:443"], "deny": ["tag:qode-office:4319", "tag:qode-office:4320", "tag:qode-office:22"] }
  ]
}
